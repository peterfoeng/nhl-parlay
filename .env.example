# Postgres connection, for example a Neon pooled URL from the Vercel Marketplace.
# Leave unset to use the JSON file store in ./data (the local default).
DATABASE_URL=

# Required for /api/cron. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
# The manual CLI (npm run job) does not use this.
CRON_SECRET=

# Optional. The Odds API (https://the-odds-api.com) is called only when this is set.
# Read when the job runs. Never commit a real key.
ODDS_API_KEY=

# Comma-separated market keys. Each market costs one credit per region per event.
# Default: anytime goal, player points (over 0.5 is the anytime-point leg) and shots
# (over 1.5 and over 2.5). player_shots_on_goal_alternate adds the other shot lines
# and costs one more credit per game.
ODDS_API_MARKETS=player_goal_scorer_anytime,player_points,player_shots_on_goal

# One region keeps the cost at (markets × 1) per game. NHL player props are on US
# books. au does not carry them. Adding us2 would double the cost.
ODDS_API_REGIONS=us

# Hours to reuse a priced Odds API response from http_cache. Empty responses retry sooner.
ODDS_API_CACHE_HOURS=6

# Provider order. A failed provider is skipped. Default: sportsbet,pointsbet,oddsapi
ODDS_PROVIDERS=sportsbet,pointsbet,oddsapi

# JSON store and HTTP cache directory when DATABASE_URL is unset. Default: ./data
DATA_DIR=./data
